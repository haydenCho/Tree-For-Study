# 운영 리버스 프록시(Caddy). 사용자 → Caddy(HTTPS) → FastAPI → DB.
#
# SITE_ADDRESS에 실제 도메인(예: tree.example.com)을 넣으면 Caddy가 Let's Encrypt 인증서를
# 자동 발급·갱신하고 80→443 리디렉트를 한다. 값이 없으면 :80 평문(로컬 점검 전용)으로 뜬다.
#
# 클라이언트 IP: Caddy는 직접 받은 연결 주소를 X-Forwarded-For에 넣어 backend로 보낸다.
# trusted_proxies를 설정하지 않았으므로 클라이언트가 보낸 X-Forwarded-For는 신뢰하지 않는다.
# FastAPI는 이 Caddy 컨테이너 주소(TRUSTED_PROXY_IPS)에서 온 헤더만, 그것도 오른쪽 값만 사용한다.
{
	# 관리 API는 외부에 열지 않는다.
	admin off
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		# 보안 헤더. HSTS는 HTTPS(도메인 설정)일 때만 브라우저가 적용한다.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), notifications=(), vibrate=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API 트래픽 -> FastAPI(내부 네트워크 전용, 외부 포트 없음)
	handle /api/* {
		reverse_proxy backend:8000
	}

	# 빌드된 SPA. 해시가 붙은 정적 자원은 오래 캐시하고 index.html은 매번 확인한다.
	handle /assets/* {
		root * /srv/www
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/www
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		# 접근 로그에 쿠키·인증 헤더를 남기지 않는다.
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
