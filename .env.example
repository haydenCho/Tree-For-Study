# Tree for Study — environment template.
# Copy to `.env` and fill real values. `.env` is gitignored and never committed.
# VITE_* values are PUBLIC (bundled into the browser). Never put secrets in VITE_*.

# ── Database (SECRET) ─────────────────────────────────────────────
POSTGRES_USER=tfs
POSTGRES_PASSWORD=
POSTGRES_DB=tree_for_study
# App connects with the async driver. Host is the compose service name `db`.
DATABASE_URL=postgresql+asyncpg://tfs:@db:5432/tree_for_study

# ── JWT / auth (SECRET) ───────────────────────────────────────────
# Generate a strong 256-bit+ random secret, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=tree-for-study
JWT_AUDIENCE=tree-for-study-web
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# ── Server config (not secret, but environment-specific) ──────────
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Comma-separated IPs of the trusted reverse proxy (Caddy). FastAPI only reads
# the forwarded client IP from these connections. Empty in local dev.
TRUSTED_PROXY_IPS=
TZ=Asia/Seoul

# ── Frontend (PUBLIC) ─────────────────────────────────────────────
VITE_API_BASE_URL=/api
