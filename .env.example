# Tree for Study — 환경 변수 템플릿.
# `.env`로 복사해 실제 값을 채운다. `.env`는 gitignore 되어 커밋되지 않는다.
# VITE_* 값은 공개(브라우저 번들에 포함)이다. 절대 VITE_*에 비밀값을 넣지 않는다.

# ── 데이터베이스 (비밀) ───────────────────────────────────────────
POSTGRES_USER=tfs
POSTGRES_PASSWORD=
POSTGRES_DB=tree_for_study
# 앱은 비동기 드라이버로 접속한다. 호스트는 compose 서비스명 `db`.
DATABASE_URL=postgresql+asyncpg://tfs:@db:5432/tree_for_study

# ── JWT / 인증 (비밀) ─────────────────────────────────────────────
# 강력한 256비트 이상 난수 시크릿을 생성한다. 예) python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=tree-for-study
JWT_AUDIENCE=tree-for-study-web
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# ── 서버 설정 (비밀은 아니지만 환경별로 다름) ─────────────────────
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# 신뢰하는 리버스 프록시(Caddy)의 IP를 쉼표로 구분. FastAPI는 이 연결에서 온
# 전달된 클라이언트 IP만 읽는다. 로컬 개발에서는 비워 둔다.
TRUSTED_PROXY_IPS=
TZ=Asia/Seoul
# development / production. 운영 compose는 production으로 고정하고 시작 시
# JWT_SECRET 길이·COOKIE_SECURE·https APP_ORIGIN·TRUSTED_PROXY_IPS를 검사한다.
ENVIRONMENT=development

# ── 운영 배포(compose.production.yaml 전용) ──────────────────────────
# 실제 도메인. 설정하면 Caddy가 HTTPS 인증서를 자동 발급한다. 운영에서는 APP_ORIGIN=https://<도메인>.
# SITE_ADDRESS=tree.example.com
# 일일 백업 외부 사본(선택). EC2 인스턴스 역할로 인증하며 액세스 키를 파일에 두지 않는다.
# BACKUP_S3_URI=s3://bucket/tree-for-study

# ── 로컬 개발 호스트 포트 (compose.yaml 전용, 선택) ────────────────
# 다른 프로젝트와 포트가 겹칠 때만 주석을 풀고 바꾼다. 운영 스택은 사용하지 않는다.
# DB_HOST_PORT=5432
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173

# ── 프론트엔드 (공개) ─────────────────────────────────────────────
VITE_API_BASE_URL=/api
